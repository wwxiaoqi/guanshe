<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wwxiaoqi.guanshe"
    android:versionCode="16"
    android:versionName="1.1.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PaletteDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ColorDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SourceSetsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CardSetActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PickActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name=".ui.ShareProvider"
            android:authorities="com.wwxiaoqi.guanshe.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
